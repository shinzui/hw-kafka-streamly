packages:
  hw-kafka-streamly
  hw-kafka-streamly-jitsurei

with-compiler: ghc-9.12.4

test-show-details: direct

allow-newer:
  -- GHC 9.12 ships with updated boot libraries
  *:time
  , *:containers
  , *:template-haskell
  , *:text
  , *:bytestring
  , *:base
  , *:ghc-prim
  , *:deepseq
  , *:filepath

-- hw-kafka-client fork: surfaces consumer fatal errors in async callback-poll
-- mode and fixes the polled-message leak in the background callback loop.
--
-- Upstream (5.3.0) drops consumer-queue messages with `void` in
-- pollConsumerEvents'. librdkafka delivers a raised fatal error to the
-- high-level consumer only as a consumer error on that queue -- never through
-- error_cb -- so in the default CallbackPollModeAsync a fatal error such as a
-- fenced static group member is unobservable at every layer, and the
-- application polls an empty side queue forever. The fork reports it in-band
-- from pollMessage/pollMessageBatch and destroys what the loop consumes.
--
-- Pinned by commit, never by branch, so the resolution is reproducible.
-- Remove this stanza to fall back to Hackage hw-kafka-client 5.3.0 exactly.
--
-- Upstream PR: prepared but not yet submitted (see
-- keiro docs/plans/135-surface-librdkafka-fatal-errors-through-the-consumer-stack.md).
source-repository-package
  type: git
  location: https://github.com/shinzui/hw-kafka-client.git
  tag: 5259ddf3c8811b662470b773f8c3d7ed52602c7e
