packages:
  hw-kafka-streamly
  hw-kafka-streamly-jitsurei

-- Resolve streamly/streamly-core from Hackage (0.3.x/0.11.x).
-- To work against an unreleased upstream checkout, re-add an
-- `optional-packages:` block pointing at the local streamly project.

with-compiler: ghc-9.12.2

test-show-details: direct

allow-newer:
  -- GHC 9.12 ships with updated boot libraries
  *:time
  , *:containers
  , *:template-haskell
  , *:text
  , *:bytestring
  , *:base
  , *:ghc-prim
  , *:deepseq
  , *:filepath
